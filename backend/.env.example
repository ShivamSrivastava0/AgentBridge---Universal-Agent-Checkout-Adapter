# ── Server ────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
LOG_LEVEL=info
PUBLIC_API_URL=http://localhost:3001
PUBLIC_APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# ── Database ──────────────────────────────────────────────
# Leave empty to use embedded Postgres (PGlite) stored in ./.data/pg.
# Set to a real Postgres URL (e.g. Neon) for production.
DATABASE_URL=
PGLITE_DATA_DIR=./.data/pg

# ── Secrets (required in production) ──────────────────────
ADMIN_API_KEY=dev_admin_key_change_me_please
APP_SECRET=dev_app_secret_change_me_please
# ES256 private JWK for signing mandates. Generate with: npm run keys:generate
# In development a key is generated into ./.data/mandate-signing-key.json.
MANDATE_SIGNING_JWK=

# ── Demo data ─────────────────────────────────────────────
SEED_DEMO_DATA=true
DEMO_AGENT_KEY_CLAUDE=ak_demo_claude_mcp_0001
DEMO_AGENT_KEY_CHATGPT=ak_demo_chatgpt_acp_0001
DEMO_AGENT_KEY_GEMINI=ak_demo_gemini_ap2_0001

# ── Payments ──────────────────────────────────────────────
# Leave empty for simulated payments. Use Razorpay *test* keys to enable real checkout.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Risk rules ────────────────────────────────────────────
RISK_HIGH_VALUE_PAISE=500000
RISK_VELOCITY_MAX_ORDERS=5
RISK_VELOCITY_WINDOW_SECONDS=300
ORDER_APPROVAL_TTL_MINUTES=60

# ── Claude agent demo (npm run demo:agent) ────────────────
ANTHROPIC_API_KEY=
MANDATE_TOKEN=
