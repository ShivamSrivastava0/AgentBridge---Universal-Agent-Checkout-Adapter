{
  "name": "agentbridge-backend",
  "version": "2.0.0",
  "description": "AgentBridge core: one commerce backend for ACP, MCP and AP2 agents, with a cryptographic mandate trust layer and Razorpay settlement.",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:reset": "tsx src/scripts/reset-db.ts",
    "keys:generate": "tsx src/scripts/generate-keys.ts",
    "mcp:stdio": "tsx src/mcp-stdio.ts",
    "demo:agent": "tsx src/demo/claude-agent.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@electric-sql/pglite": "^0.5.17",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "razorpay": "^2.9.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
